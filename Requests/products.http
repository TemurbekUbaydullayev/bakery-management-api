@baseUrl = http://localhost:5149
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..P2XPp0RIpJutKH_Bo7DAvgQU0vviTAdk1HDTK5QbEK4

### Get All Products
GET {{baseUrl}}/api/Product
Authorization: Bearer {{token}}

### Get Product by Id
GET {{baseUrl}}/api/Product/{{productId}}
Authorization: Bearer {{token}}

### Create Product
POST {{baseUrl}}/api/Product
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Non",
    "category": "Bread",
    "price": 5000
}

### Update Product
PUT {{baseUrl}}/api/Product/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Non",
    "category": "Bread",
    "isAvailable": true
}

### Set Price
PUT {{baseUrl}}/api/Product/{{productId}}/price
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "price": 6000
}

### Delete Product
DELETE {{baseUrl}}/api/Product/{{productId}}
Authorization: Bearer {{token}}